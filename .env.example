# Copy to .env in the directory where you start the CLI/API. Existing environment wins.
# Live calls fail on configuration/auth/model errors; select demo explicitly for offline use.
CONTOSO_STORE=local
CONTOSO_DATA_DIR=.data
CONTOSO_AGENT_MODE=live
CONTOSO_WORKER_MODE=inprocess
CONTOSO_WORKER_TIMEOUT_SECONDS=120
# Preferred live model: Foundry OpenAI-compatible v1 endpoint and deployment name.
# Set BOTH values, then authenticate locally with az login. No API key is needed.
# The AzureCliCredential token provider requests https://ai.azure.com/.default.
# Example endpoint: https://<resource>.services.ai.azure.com/openai/v1/
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
# Foundry settings take priority over the optional alternatives below.
# Optional alternative: OpenAI (leave both Foundry values blank).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative: Azure OpenAI + DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
# Live research: exact public HTTPS hosts and optional evidence URLs.
CONTOSO_WEB_ALLOWED_HOSTS=en.wikipedia.org,learn.microsoft.com,docs.python.org
CONTOSO_WEB_URLS=
# Azure storage uses identity; create the private container first.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=contoso-workflow
CONTOSO_AZURE_CREDENTIAL=default
# Set CONTOSO_AZURE_CREDENTIAL=managed_identity for an Azure-hosted worker.
AZURE_CLIENT_ID=
