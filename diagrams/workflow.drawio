          <mxGeometry x="60" y="35" width="1440" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="CONTROL PLANE - caller invokes workers; Blob never schedules containers" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#475569;fontSize=17;fontStyle=1;" vertex="1" parent="1">
