          <mxGeometry x="1200" y="820" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="Separate-container deployment requires an explicit transport adapter and matching worker image; the sample demonstrates fixed subprocess handoff.&lt;br/&gt;Blob stores data, not code or scheduling. This is conversation restoration between turns, not arbitrary in-flight MAF checkpoint recovery." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#475569;fontSize=15;" vertex="1" parent="1">
