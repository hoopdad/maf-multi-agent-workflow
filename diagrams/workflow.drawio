          <mxGeometry x="440" y="400" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="SHARED AZURE BLOB DATA PLANE&lt;br/&gt;Immutable artifacts and state snapshots&lt;br/&gt;Committed SessionState with revision; session lease&lt;br/&gt;Research JSON / Markdown and deck JSON / editable PPTX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F1;strokeColor=#187867;fontColor=#163D35;fontSize=16;spacing=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="680" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="RESTART BETWEEN TURNS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#475569;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="New process or container&lt;br/&gt;Same session_id and Blob config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#183153;fontSize=16;spacing=15;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="Load committed SessionState&lt;br/&gt;Acquire session lease&lt;br/&gt;Restore all user and assistant turns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F1;strokeColor=#187867;fontColor=#163D35;fontSize=15;spacing=15;strokeWidth=2;" vertex="1" parent="1">
