        <mxCell id="6" value="Research / PPT worker&lt;br/&gt;Same fixed package and config&lt;br/&gt;Validate references before use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2563A6;fontColor=#183153;fontSize=16;spacing=15;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="220" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="Caller receives WorkerResult&lt;br/&gt;Session and kind correlation&lt;br/&gt;Validated output ArtifactRefs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#183153;fontSize=16;spacing=15;strokeWidth=2;" vertex="1" parent="1">
